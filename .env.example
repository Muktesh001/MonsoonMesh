NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://monsoonmesh:monsoonmesh@localhost:5432/monsoonmesh
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
AI_SERVICE_URL=http://localhost:8000
VITE_API_URL=http://localhost:4000/api
VITE_DEMO_MODE=false
GEMINI_API_KEY=
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=./logs
ENABLE_AUDIT_LOGS=true
ENABLE_ERROR_TRACKING=false

# Weather API Configuration
API_CALL_TIMEOUT_MS=10000
API_MAX_RETRIES=3
WEATHER_CACHE_TTL_SECONDS=300

# External Weather API Credentials
# India Meteorological Department (https://mausam.imd.gov.in/)
IMD_API_KEY=
IMD_BASE_URL=https://mausam.imd.gov.in

# NASA Global Precipitation Measurement (https://giovanni.gsfc.nasa.gov/)
NASA_GPM_TOKEN=
NASA_GPM_BASE_URL=https://giovanni.gsfc.nasa.gov

# OpenWeatherMap (https://openweathermap.org/api)
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org

# USGS Flood Data (https://waterdata.usgs.gov/)
USGS_BASE_URL=https://waterdata.usgs.gov
